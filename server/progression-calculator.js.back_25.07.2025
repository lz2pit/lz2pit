// server/progression-calculator.js
import { createRequire } from 'module';

const require = createRequire(import.meta.url);
const swisseph = require('swisseph');

/**
 * Модул за изчисляване на астрологични прогресии
 * Използва метода "ден за година" (Secondary Progressions)
 */
class ProgressionCalculator {
  constructor() {
    console.log("Progression Calculator инициализиран");

    // Дефиниции на планетарните индекси - ВКЛЮЧИТЕЛНО Слънце и Луна
    this.planetIndices = {
      "Слънце": swisseph.SE_SUN,
      "Луна": swisseph.SE_MOON,
      "Меркурий": swisseph.SE_MERCURY,
      "Венера": swisseph.SE_VENUS,
      "Марс": swisseph.SE_MARS,
      "Юпитер": swisseph.SE_JUPITER,
      "Сатурн": swisseph.SE_SATURN,
      "Уран": swisseph.SE_URANUS,
      "Нептун": swisseph.SE_NEPTUNE,
      "Плутон": swisseph.SE_PLUTO
    };

    // Мажорни аспекти за прогресии
    // Стандартен орбис 1°, за Луната 1.5°, за домове 2°
    this.progressionAspects = [
      { name: "Съвпад", angle: 0, orb: 1, orbMoon: 1.5, orbHouse: 1, symbol: "☌" },
      { name: "Секстил", angle: 60, orb: 1, orbMoon: 1.5, orbHouse: 1, symbol: "⚹" },
      { name: "Квадратура", angle: 90, orb: 1, orbMoon: 1.5, orbHouse: 1, symbol: "□" },
      { name: "Тригон", angle: 120, orb: 1, orbMoon: 1.5, orbHouse: 1, symbol: "△" },
      { name: "Опозиция", angle: 180, orb: 1, orbMoon: 1.5, orbHouse: 1, symbol: "☍" }
    ];

    // Символи на планетите за показване
    this.planetSymbols = {
      "Слънце": "☉",
      "Луна": "☽", 
      "Меркурий": "☿",
      "Венера": "♀",
      "Марс": "♂",
      "Юпитер": "♃",
      "Сатурн": "♄",
      "Уран": "♅",
      "Нептун": "♆",
      "Плутон": "♇"
    };

    // Зодиакални знаци
    this.zodiacSigns = [
      { name: "Овен", symbol: "♈", start: 0 },
      { name: "Телец", symbol: "♉", start: 30 },
      { name: "Близнаци", symbol: "♊", start: 60 },
      { name: "Рак", symbol: "♋", start: 90 },
      { name: "Лъв", symbol: "♌", start: 120 },
      { name: "Дева", symbol: "♍", start: 150 },
      { name: "Везни", symbol: "♎", start: 180 },
      { name: "Скорпион", symbol: "♏", start: 210 },
      { name: "Стрелец", symbol: "♐", start: 240 },
      { name: "Козирог", symbol: "♑", start: 270 },
      { name: "Водолей", symbol: "♒", start: 300 },
      { name: "Риби", symbol: "♓", start: 330 }
    ];
  }

  /**
   * Изчислява прогресивна юлианска дата по метода "ден за година"
   * @param {number} birthJD - Юлианска дата на раждането
   * @param {number} targetJD - Юлианска дата за която изчисляваме прогресиите
   * @returns {number} Прогресивна юлианска дата
   */
  calculateProgressedJD(birthJD, targetJD) {
    // За Secondary Progressions: 1 ден = 1 година
    const daysDifference = targetJD - birthJD;
    const yearsFromBirth = daysDifference / 365.25;

    // ВАЖНА КОРЕКЦИЯ: За Secondary Progressions добавяме броя години КЪМ датата на раждане
    // като брой ДНИ, а не като години
    const progressedJD = birthJD + yearsFromBirth;

    return progressedJD;
  }

  /**
   * Изчислява позициите на прогресивните планети
   * @param {number} progressedJD - Прогресивна юлианска дата
   * @param {number} lat - Географска ширина
   * @param {number} lon - Географска дължина
   * @returns {Object} Обект с прогресивните позиции
   */
  calculateProgressedPlanets(progressedJD, lat = 43.4167, lon = 24.6167) {
    const progressedPlanets = {};

    try {
      // Изчисляваме позициите на ВСИЧКИ планети, включително Слънце и Луна
      for (const [name, index] of Object.entries(this.planetIndices)) {
        try {
          const result = swisseph.swe_calc_ut(progressedJD, index, swisseph.SEFLG_SWIEPH | swisseph.SEFLG_SPEED);
          if (!result.error) {
            progressedPlanets[name] = {
              longitude: result.longitude,
              speed: result.longitudeSpeed,
              isRetrograde: result.longitudeSpeed < 0
            };
          }
        } catch (error) {
          console.error(`Error calculating progressed ${name}:`, error);
        }
      }

      // Изчисляваме прогресивните домове (ASC и MC се движат също)
      try {
        const progressedHouses = swisseph.swe_houses(progressedJD, lat, lon, 'P');

        if (progressedHouses && progressedHouses.house) {
          // Добавяме прогресивните върхове на домовете
          for (let i = 0; i < 12; i++) {
            progressedPlanets[`Дом ${i + 1}`] = {
              longitude: progressedHouses.house[i],
              speed: 0,
              isRetrograde: false
            };
          }

          // Добавяме прогресивни ASC и MC
          progressedPlanets["Асцендент"] = {
            longitude: progressedHouses.ascendant || 0,
            speed: 0,
            isRetrograde: false
          };
          progressedPlanets["MC"] = {
            longitude: progressedHouses.mc || 0,
            speed: 0,
            isRetrograde: false
          };
        }
      } catch (error) {
        console.error("Error calculating progressed houses:", error);
      }

    } catch (error) {
      console.error("Error in calculateProgressedPlanets:", error);
    }

    return progressedPlanets;
  }

  /**
   * Намира прогресивни аспекти за определена дата
   * @param {Object} birthData - Данни за раждането
   * @param {number} natalJD - Натална юлианска дата
   * @param {Object} natalPoints - Натални позиции на планетите и домовете
   * @param {number} targetJD - Юлианска дата за която търсим прогресии
   * @param {number} lat - Географска ширина
   * @param {number} lon - Географска дължина
   * @returns {Array} Масив с намерени прогресии
   */
  calculateProgressions(birthData, natalJD, natalPoints, targetJD, lat = 43.4167, lon = 24.6167) {
    const progressions = [];

    try {
      // Изчисляваме прогресивната юлианска дата
      const progressedJD = this.calculateProgressedJD(natalJD, targetJD);

      // Изчисляваме прогресивните позиции на ВСИЧКИ планети
      const progressedPlanets = this.calculateProgressedPlanets(progressedJD, lat, lon);

      // Търсим аспекти между прогресивни планети и ВСИЧКИ натални точки
      for (const [progPlanetName, progData] of Object.entries(progressedPlanets)) {
        // Пропускаме само прогресивните домове и асцендент
        // (не искаме прогресивен дом към натален дом)
        if (progPlanetName.startsWith('Дом') || progPlanetName === 'Асцендент' || progPlanetName === 'MC') {
          continue; // ! ВАЖНО: Не прескачай наталните домове!
        }

        for (const [natalPoint, natalLongitude] of Object.entries(natalPoints)) {
          const aspectAngle = this.calculateAspectAngle(progData.longitude, natalLongitude);

          for (const aspect of this.progressionAspects) {
            const diff = Math.abs(aspectAngle - aspect.angle);

            // Определяме орбиса според типа на наталната точка
            let allowedOrb = aspect.orb;

            // За Луната използваме специален орбис
            if (progPlanetName === "Луна") {
              allowedOrb = aspect.orbMoon || aspect.orb;
            }

            // За аспекти към ВСИЧКИ домове използваме 2°
            if (natalPoint.startsWith("Дом") ||
                natalPoint === "ASC" || natalPoint === "MC" ||
                natalPoint === "IC" || natalPoint === "DSC" ||
                natalPoint === "Асцендент" ||
                // Проверяваме дали е число (за домове като "2", "3", "5", etc.)
                /^\d+$/.test(natalPoint)) {
              allowedOrb = aspect.orbHouse || 2;
            }

            if (diff <= allowedOrb) {
              const formattedNatalPoint = this.formatNatalPoint(natalPoint);

              const progression = {
                transitPlanet: progPlanetName,
                aspect: aspect.name,
                symbol: aspect.symbol,
                natalPoint: formattedNatalPoint,
                orb: diff.toFixed(2),
                isRetrograde: progData.isRetrograde
              };

              progressions.push(progression);
              break; // Вземаме само първия намерен аспект
            }
          }
        }
      }

    } catch (error) {
      console.error("Error in calculateProgressions:", error);
    }

    console.log("DEBUG ВСИЧКИ прогресии:", progressions.map(p =>
      `${p.transitPlanet} ${p.symbol} ${p.natalPoint} orb:${p.orb}`
    ));

    return progressions;
  }

  /**
   * Определя зодиакалния знак според еклиптичната дължина
   * @param {number} longitude - Еклиптична дължина в градуси
   * @returns {Object} Обект със знак и градуси в знака
   */
  getZodiacSign(longitude) {
    const normalizedLongitude = ((longitude % 360) + 360) % 360;
    const signIndex = Math.floor(normalizedLongitude / 30);
    const degrees = normalizedLongitude % 30;
    
    return {
      name: this.zodiacSigns[signIndex].name,
      symbol: this.zodiacSigns[signIndex].symbol,
      degrees: degrees
    };
  }

  /**
   * Инициализира позициите на прогресивните планети за определена дата
   * @param {Date} date - Дата за инициализация
   * @param {number} natalJD - Натална юлианска дата
   * @returns {Object} Обект с начални позиции
   */
  initializeProgressedPlanetSigns(date, natalJD) {
    const [year, month, day] = [date.getFullYear(), date.getMonth() + 1, date.getDate()];
    const targetJD = swisseph.swe_julday(year, month, day, 12, swisseph.SE_GREG_CAL);
    const progressedJD = this.calculateProgressedJD(natalJD, targetJD);
    
    const signs = {};
    
    for (const [planetName, planetIndex] of Object.entries(this.planetIndices)) {
      try {
        const result = swisseph.swe_calc_ut(progressedJD, planetIndex, swisseph.SEFLG_SWIEPH | swisseph.SEFLG_SPEED);
        if (!result.error) {
          const sign = this.getZodiacSign(result.longitude);
          signs[planetName] = {
            sign: sign.name,
            longitude: result.longitude,
            isRetrograde: result.longitudeSpeed < 0
          };
        }
      } catch (error) {
        console.error(`Error initializing progressed ${planetName}:`, error);
      }
    }
    
    return signs;
  }

  /**
   * Проверява за прогресивни ингресии за конкретна дата
   * @param {Date} currentDate - Текуща дата
   * @param {Object} previousSigns - Знаци от предишния ден
   * @param {number} natalJD - Натална юлианска дата
   * @returns {Object} Обект с намерени ингресии и обновени знаци
   */
  checkProgressionIngressesForDate(currentDate, previousSigns, natalJD) {
    const [year, month, day] = [currentDate.getFullYear(), currentDate.getMonth() + 1, currentDate.getDate()];
    const targetJD = swisseph.swe_julday(year, month, day, 12, swisseph.SE_GREG_CAL);
    const progressedJD = this.calculateProgressedJD(natalJD, targetJD);
    
    const ingresses = [];
    const updatedSigns = {};
    
    console.log(`🔍 Checking progression ingresses for: ${currentDate.toISOString().split('T')[0]}`);

    for (const [planetName, planetIndex] of Object.entries(this.planetIndices)) {
      try {
        const result = swisseph.swe_calc_ut(progressedJD, planetIndex, swisseph.SEFLG_SWIEPH | swisseph.SEFLG_SPEED);
        if (!result.error) {
          const currentSign = this.getZodiacSign(result.longitude);
          const isRetrograde = result.longitudeSpeed < 0;
          
          // Проверяваме дали има промяна в знака
          const previousSign = previousSigns[planetName]?.sign;
          if (previousSign && previousSign !== currentSign.name) {
            const ingress = {
              planet: planetName,
              sign: currentSign.name,
              isRetrograde: isRetrograde,
              type: 'progression',
              longitude: result.longitude,
              date: currentDate.toISOString().split('T')[0]
            };
            
            ingresses.push(ingress);
            
            console.log(`🌟 PROGRESSION INGRESS FOUND: ${planetName} ${previousSign} → ${currentSign.name} (${isRetrograde ? 'R' : 'D'})`);
          }
          
          // Обновяваме знака
          updatedSigns[planetName] = {
            sign: currentSign.name,
            longitude: result.longitude,
            isRetrograde: isRetrograde
          };
        }
      } catch (error) {
        console.error(`Error calculating progressed ${planetName} for ingress:`, error);
      }
    }

    if (ingresses.length === 0) {
      console.log(`❌ No progression ingresses found for ${currentDate.toISOString().split('T')[0]}`);
    }

    return {
      ingresses: ingresses,
      updatedSigns: updatedSigns
    };
  }

  /**
   * Изчислява всички прогресивни ингресии за период
   * @param {Date} startDate - Начална дата
   * @param {Date} endDate - Крайна дата
   * @param {number} natalJD - Натална юлианска дата
   * @returns {Object} Обект с ингресии по дати
   */
  calculateProgressionIngressesForPeriod(startDate, endDate, natalJD) {
    console.log(`=== CALCULATING PROGRESSION INGRESSES FOR PERIOD ===`);
    console.log(`From: ${startDate.toISOString().split('T')[0]}`);
    console.log(`To: ${endDate.toISOString().split('T')[0]}`);
    
    const ingressesByDate = {};
    
    // Инициализираме знаците за деня преди началото
    const initDate = new Date(startDate);
    initDate.setDate(initDate.getDate() - 1);
    let planetSigns = this.initializeProgressedPlanetSigns(initDate, natalJD);
    
    console.log(`Initial progressed planet signs:`, Object.entries(planetSigns).map(([planet, data]) => 
      `${planet}: ${data.sign} (${data.isRetrograde ? 'R' : 'D'})`
    ).join(', '));

    // Итерираме през всеки ден
    const currentDate = new Date(startDate);
    while (currentDate <= endDate) {
      const dateString = currentDate.toISOString().split('T')[0];
      
      const result = this.checkProgressionIngressesForDate(currentDate, planetSigns, natalJD);
      
      if (result.ingresses.length > 0) {
        ingressesByDate[dateString] = result.ingresses;
      }
      
      // Обновяваме знаците за следващия ден
      planetSigns = result.updatedSigns;
      
      // Преминаваме към следващия ден
      currentDate.setDate(currentDate.getDate() + 1);
    }

    const totalIngresses = Object.values(ingressesByDate).reduce((sum, ingresses) => sum + ingresses.length, 0);
    console.log(`=== PROGRESSION INGRESSES CALCULATION COMPLETED ===`);
    console.log(`Total progression ingresses found: ${totalIngresses}`);
    console.log(`Days with progression ingresses: ${Object.keys(ingressesByDate).length}`);
    
    return ingressesByDate;
  }

  /**
   * Тестова функция за прогресивни ингресии на конкретна дата
   * @param {string} testDate - Дата във формат YYYY-MM-DD
   * @param {number} natalJD - Натална юлианска дата
   * @returns {Array} Прогресивни ингресии за тестваната дата
   */
  testProgressionIngressForDate(testDate, natalJD) {
    console.log(`\n🧪 TESTING PROGRESSION INGRESSES FOR: ${testDate}`);
    
    const currentDate = new Date(testDate);
    const previousDate = new Date(currentDate);
    previousDate.setDate(previousDate.getDate() - 1);
    
    // Инициализираме знаците за предишния ден
    const previousSigns = this.initializeProgressedPlanetSigns(previousDate, natalJD);
    
    // Проверяваме за ингресии
    const result = this.checkProgressionIngressesForDate(currentDate, previousSigns, natalJD);
    
    if (result.ingresses.length > 0) {
      console.log(`✅ Found ${result.ingresses.length} progression ingresses:`);
      result.ingresses.forEach(ingress => {
        console.log(`   ${ingress.planet} → ${ingress.sign} ${ingress.isRetrograde ? '(R)' : '(D)'}`);
      });
    } else {
      console.log(`❌ No progression ingresses found for this date`);
    }
    
    return result.ingresses;
  }

  /**
   * Форматира натална точка според изискванията
   * @param {string} natalPoint - Име на наталната точка
   * @returns {string} Форматирано име
   */
  formatNatalPoint(natalPoint) {
    // Домовете да се показват като ASC,2,3,IC,5,6,DSC,8,9,MC,11,12
    if (natalPoint === "Дом 1" || natalPoint === "Асцендент") {
      return "ASC";
    } else if (natalPoint === "Дом 2") {
      return "2";
    } else if (natalPoint === "Дом 3") {
      return "3";
    } else if (natalPoint === "Дом 4") {
      return "IC";
    } else if (natalPoint === "Дом 5") {
      return "5";
    } else if (natalPoint === "Дом 6") {
      return "6";
    } else if (natalPoint === "Дом 7") {
      return "DSC";
    } else if (natalPoint === "Дом 8") {
      return "8";
    } else if (natalPoint === "Дом 9") {
      return "9";
    } else if (natalPoint === "Дом 10" || natalPoint === "MC") {
      return "MC";
    } else if (natalPoint === "Дом 11") {
      return "11";
    } else if (natalPoint === "Дом 12") {
      return "12";
    }

    // За планети показваме само глифовете
    if (this.planetSymbols[natalPoint]) {
      return this.planetSymbols[natalPoint];
    }

    return natalPoint;
  }

  /**
   * Изчислява аспектния ъгъл между две позиции
   * @param {number} long1 - Първа долгота
   * @param {number} long2 - Втора долгота
   * @returns {number} Аспектен ъгъл (0-180°)
   */
  calculateAspectAngle(long1, long2) {
    let angle = Math.abs(long1 - long2);
    if (angle > 180) angle = 360 - angle;
    return angle;
  }

  /**
   * Проверява дали определена дата попада в точен прогресивен аспект
   * Специално за тестване на конкретни дати
   * @param {Object} birthData - Данни за раждането
   * @param {string} testDate - Дата за тестване (YYYY-MM-DD)
   * @param {Object} natalPoints - Натални позиции
   * @param {number} natalJD - Натална юлианска дата
   * @returns {Array} Прогресии за тестваната дата
   */
  testProgressionForDate(birthData, testDate, natalPoints, natalJD) {
    const [year, month, day] = testDate.split('-').map(Number);
    const testJD = swisseph.swe_julday(year, month, day, 12, swisseph.SE_GREG_CAL);

    console.log(`\n🔍 TESTING PROGRESSIONS FOR: ${testDate}`);
    const progressions = this.calculateProgressions(birthData, natalJD, natalPoints, testJD);

    if (progressions.length > 0) {
      console.log(`✅ Found ${progressions.length} progressions:`);
      progressions.forEach(prog => {
        console.log(`   ${prog.transitPlanet} ${prog.symbol} ${prog.natalPoint} (orb: ${prog.orb}°)`);
      });
    } else {
      console.log(`❌ No progressions found for this date`);
    }

    return progressions;
  }

  /**
   * Форматира прогресивна ингресия за показване във frontend
   * @param {Object} ingress - Обект с ингресия
   * @returns {Object} Форматирана ингресия
   */
  formatProgressionIngress(ingress) {
    return {
      planet: ingress.planet,
      planetSymbol: this.planetSymbols[ingress.planet] || ingress.planet,
      sign: ingress.sign,
      signSymbol: this.zodiacSigns.find(sign => sign.name === ingress.sign)?.symbol || ingress.sign,
      isRetrograde: ingress.isRetrograde,
      type: 'progression',
      formatted: `${this.planetSymbols[ingress.planet] || ingress.planet}→${this.zodiacSigns.find(sign => sign.name === ingress.sign)?.symbol || ingress.sign}`
    };
  }
}

export default ProgressionCalculator;