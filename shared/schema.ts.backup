import { pgTable, text, serial, integer, real, timestamp } from "drizzle-orm/pg-core";
import { createInsertSchema } from "drizzle-zod";
import { z } from "zod";

export const users = pgTable("users", {
  id: serial("id").primaryKey(),
  username: text("username").notNull().unique(),
  password: text("password").notNull(),
});

export const natalCharts = pgTable("natal_charts", {
  id: serial("id").primaryKey(),
  name: text("name").notNull(),
  gender: text("gender").notNull(),
  birthYear: integer("birth_year").notNull(),
  birthMonth: integer("birth_month").notNull(),
  birthDay: integer("birth_day").notNull(),
  birthHour: integer("birth_hour").notNull(),
  birthMinute: integer("birth_minute").notNull(),
  birthSecond: integer("birth_second").default(0),
  city: text("city").notNull(),
  country: text("country").notNull(),
  latitude: real("latitude").notNull(),
  longitude: real("longitude").notNull(),
  planetPositions: text("planet_positions").notNull(), // JSON string
  housePositions: text("house_positions").notNull(), // JSON string
  aspects: text("aspects").notNull(), // JSON string
  createdAt: timestamp("created_at").defaultNow(),
});

export const insertUserSchema = createInsertSchema(users).pick({
  username: true,
  password: true,
});

export const insertNatalChartSchema = createInsertSchema(natalCharts).omit({
  id: true,
  createdAt: true,
});

export const birthDataSchema = z.object({
  name: z.string().min(1, "Името е задължително"),
  gender: z.enum(["Мъж", "Жена"], { required_error: "Изберете пол" }),
  year: z.number().min(1900).max(2100),
  month: z.number().min(1).max(12),
  day: z.number().min(1).max(31),
  hour: z.number().min(0).max(23),
  minute: z.number().min(0).max(59),
  second: z.number().min(0).max(59).default(0),
  city: z.string().min(1, "Градът е задължителен"),
  country: z.string().min(1, "Държавата е задължителна"),
});

export const coordinatesSchema = z.object({
  lat: z.number(),
  lng: z.number(),
  city: z.string(),
  country: z.string(),
});

export const planetPositionSchema = z.object({
  longitude: z.number(),
  sign: z.object({
    name: z.string(),
    symbol: z.string(),
  }),
  degree: z.number(),
  minutes: z.number(),
  seconds: z.number(),
  house: z.number(),
});

export const housePositionSchema = z.object({
  cusp: z.number(),
  sign: z.object({
    name: z.string(),
    symbol: z.string(),
  }),
  degree: z.number(),
  minutes: z.number(),
});

export const aspectSchema = z.object({
  type: z.string(),
  planet1: z.string(),
  planet2: z.string(),
  aspect: z.string(),
  orb: z.string(),
  color: z.string(),
  symbol: z.string(),
});

export const natalChartDataSchema = z.object({
  birthData: birthDataSchema,
  coordinates: coordinatesSchema,
  planets: z.record(planetPositionSchema),
  houses: z.record(housePositionSchema),
  aspects: z.array(aspectSchema),
});

export const forecastRequestSchema = z.object({
  startDate: z.string(),
  endDate: z.string(),
  birthData: birthDataSchema,
  coordinates: coordinatesSchema,
});

export type InsertUser = z.infer<typeof insertUserSchema>;
export type User = typeof users.$inferSelect;
export type InsertNatalChart = z.infer<typeof insertNatalChartSchema>;
export type NatalChart = typeof natalCharts.$inferSelect;
export type BirthData = z.infer<typeof birthDataSchema>;
export type Coordinates = z.infer<typeof coordinatesSchema>;
export type PlanetPosition = z.infer<typeof planetPositionSchema>;
export type HousePosition = z.infer<typeof housePositionSchema>;
export type Aspect = z.infer<typeof aspectSchema>;
export type NatalChartData = z.infer<typeof natalChartDataSchema>;
export type ForecastRequest = z.infer<typeof forecastRequestSchema>;
