@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --background: hsl(0, 0%, 100%);
  --foreground: hsl(20, 14.3%, 4.1%);
  --muted: hsl(60, 4.8%, 95.9%);
  --muted-foreground: hsl(25, 5.3%, 44.7%);
  --popover: hsl(0, 0%, 100%);
  --popover-foreground: hsl(20, 14.3%, 4.1%);
  --card: hsl(0, 0%, 100%);
  --card-foreground: hsl(20, 14.3%, 4.1%);
  --border: hsl(20, 5.9%, 90%);
  --input: hsl(20, 5.9%, 90%);
  --primary: hsl(207, 90%, 54%);
  --primary-foreground: hsl(211, 100%, 99%);
  --secondary: hsl(60, 4.8%, 95.9%);
  --secondary-foreground: hsl(24, 9.8%, 10%);
  --accent: hsl(60, 4.8%, 95.9%);
  --accent-foreground: hsl(24, 9.8%, 10%);
  --destructive: hsl(0, 84.2%, 60.2%);
  --destructive-foreground: hsl(60, 9.1%, 97.8%);
  --ring: hsl(20, 14.3%, 4.1%);
  --radius: 0.5rem;
  
  /* Astrology-specific colors */
  --cosmic: hsl(286, 66%, 18%);
  --celestial: hsl(227, 73%, 69%);
  --mystical: hsl(254, 44%, 53%);
  --astro-sun: hsl(51, 100%, 50%);
  --astro-moon: hsl(0, 0%, 75%);
  --astro-mercury: hsl(39, 100%, 50%);
  --astro-venus: hsl(330, 100%, 71%);
  --astro-mars: hsl(16, 100%, 50%);
  --astro-jupiter: hsl(225, 73%, 57%);
  --astro-saturn: hsl(30, 59%, 29%);
  --astro-uranus: hsl(186, 100%, 42%);
  --astro-neptune: hsl(207, 44%, 49%);
  --astro-pluto: hsl(0, 100%, 27%);
}

.dark {
  --background: hsl(240, 10%, 3.9%);
  --foreground: hsl(0, 0%, 98%);
  --muted: hsl(240, 3.7%, 15.9%);
  --muted-foreground: hsl(240, 5%, 64.9%);
  --popover: hsl(240, 10%, 3.9%);
  --popover-foreground: hsl(0, 0%, 98%);
  --card: hsl(240, 10%, 3.9%);
  --card-foreground: hsl(0, 0%, 98%);
  --border: hsl(240, 3.7%, 15.9%);
  --input: hsl(240, 3.7%, 15.9%);
  --primary: hsl(207, 90%, 54%);
  --primary-foreground: hsl(211, 100%, 99%);
  --secondary: hsl(240, 3.7%, 15.9%);
  --secondary-foreground: hsl(0, 0%, 98%);
  --accent: hsl(240, 3.7%, 15.9%);
  --accent-foreground: hsl(0, 0%, 98%);
  --destructive: hsl(0, 62.8%, 30.6%);
  --destructive-foreground: hsl(0, 0%, 98%);
  --ring: hsl(240, 4.9%, 83.9%);
  --radius: 0.5rem;
}

@layer base {
  * {
    @apply border-border;
  }

  body {
    @apply font-sans antialiased bg-gradient-to-br from-[hsl(227,73%,69%)] via-[hsl(254,44%,53%)] to-[hsl(286,66%,18%)] text-foreground min-h-screen;
    font-family: 'Inter', sans-serif;
  }
}

@layer components {
  .astro-gradient {
    @apply bg-gradient-to-r from-[hsl(227,73%,69%)] to-[hsl(254,44%,53%)];
  }
  
  .astro-gradient-reverse {
    @apply bg-gradient-to-r from-[hsl(254,44%,53%)] to-[hsl(286,66%,18%)];
  }
  
  .chart-circle {
    stroke: hsl(var(--foreground));
    stroke-width: 2;
    fill: none;
  }
  
  .house-line {
    stroke: hsl(var(--muted-foreground));
    stroke-width: 1;
  }
  
  .planet-marker {
    stroke: white;
    stroke-width: 2;
  }
  
  .aspect-line {
    stroke-width: 2;
    opacity: 0.7;
  }
  
  .planet-label {
    font-size: 12px;
    font-weight: bold;
    fill: hsl(var(--foreground));
    text-anchor: middle;
    font-family: 'Lucida Sans Unicode', 'Arial Unicode MS', sans-serif;
  }
  
  .house-label {
    font-size: 10px;
    fill: hsl(var(--muted-foreground));
    text-anchor: middle;
  }
  
  .symbol-font {
    font-family: 'Lucida Sans Unicode', 'Arial Unicode MS', sans-serif;
  }
}

@layer utilities {
  .text-cosmic { color: hsl(var(--cosmic)); }
  .text-celestial { color: hsl(var(--celestial)); }
  .text-mystical { color: hsl(var(--mystical)); }
  .text-astro-sun { color: hsl(var(--astro-sun)); }
  .text-astro-moon { color: hsl(var(--astro-moon)); }
  .text-astro-mercury { color: hsl(var(--astro-mercury)); }
  .text-astro-venus { color: hsl(var(--astro-venus)); }
  .text-astro-mars { color: hsl(var(--astro-mars)); }
  .text-astro-jupiter { color: hsl(var(--astro-jupiter)); }
  .text-astro-saturn { color: hsl(var(--astro-saturn)); }
  .text-astro-uranus { color: hsl(var(--astro-uranus)); }
  .text-astro-neptune { color: hsl(var(--astro-neptune)); }
  .text-astro-pluto { color: hsl(var(--astro-pluto)); }
  
  .bg-cosmic { background-color: hsl(var(--cosmic)); }
  .bg-celestial { background-color: hsl(var(--celestial)); }
  .bg-mystical { background-color: hsl(var(--mystical)); }

  .animate-spin-slow {
    animation: spin 2s linear infinite;
  }
}
