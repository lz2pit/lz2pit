// src/components/forecast-section.tsx
import React, { useState, useRef, useEffect } from "react";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import { TrendingUp, Download } from "lucide-react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { useToast } from "@/hooks/use-toast";
import { apiRequest } from "@/lib/queryClient";
import {
  getPlanetColor,
  getPlanetSymbol,
  getZodiacColor,
  getAspectSymbol,
  getAspectColor,
} from "@/lib/astrology-utils";
import type { NatalChartData, Coordinates } from "@shared/schema";

interface Transit {
  transitPlanet?: string;
  planet?: string;
  aspect: string;
  natalPoint?: string;
  natal?: string;
  orb: string;
  isRetrograde?: boolean;
}

interface Ingress {
  planet: string;
  planetSymbol: string;
  sign: string;
  signSymbol: string;
  isRetrograde?: boolean;
  time?: string;
}

interface DayForecast {
  date: string;
  progressions?: Transit[];
  outerPlanets?: Transit[];
  venus?: Transit[];
  mars?: Transit[];
  mercuryRetro?: Transit[];
  progressionIngressions?: Ingress[];
  transitIngresses?: Ingress[];
}

interface ForecastSectionProps {
  natalData: NatalChartData;
  coordinates: Coordinates | null;
  startDate: string;
  endDate: string;
  onStartDateChange: (d: string) => void;
  onEndDateChange: (d: string) => void;
}

export default function ForecastSection({
  natalData,
  coordinates,
  startDate,
  endDate,
  onStartDateChange,
  onEndDateChange,
}: ForecastSectionProps) {
  const { toast } = useToast();
  const [forecastData, setForecastData] = useState<DayForecast[]>([]);
  const [progress, setProgress] = useState(0);
  const esRef = useRef<EventSource | null>(null);

  const handleCalculate = async () => {
    if (!coordinates) {
      toast({ title: "Грешка", description: "Няма координати!", variant: "destructive" });
      return;
    }
    if (!startDate || !endDate) {
      toast({ title: "Грешка", description: "Моля въведете дата!", variant: "destructive" });
      return;
    }

    setProgress(0);
    // open SSE for progress updates
    esRef.current?.close();
    const es = new EventSource(
      `/api/forecast-progress?start=${startDate}&end=${endDate}`
    );
    es.onmessage = (e) => {
      try {
        const { percent } = JSON.parse(e.data);
        setProgress(percent);
      } catch {}
    };
    es.onerror = () => {
      es.close();
    };
    esRef.current = es;

    try {
      const result = await apiRequest("POST", "/api/calculate-forecast", {
        birthData: natalData.birthData,
        coordinates,
        startDate,
        endDate,
      }).then((r) => r.json());

      es.close();
      setProgress(100);

      if (result.success && Array.isArray(result.data)) {
        setForecastData(result.data);
        toast({
          title: "Успех!",
          description: `Намерени ${result.data.length} дни с аспекти и ингресии.`,
        });
      } else {
        throw new Error(result.error || "Няма данни");
      }
    } catch (err: any) {
      es.close();
      setProgress(0);
      toast({
        title: "Грешка",
        description: err.message || "Нещо се обърка",
        variant: "destructive",
      });
    }
  };

  const handleExportPDF = async () => {
    if (forecastData.length === 0) {
      toast({ title: "Грешка", description: "Няма данни за експорт!", variant: "destructive" });
      return;
    }
    try {
      const resp = await apiRequest("POST", "/api/export-forecast-pdf", {
        forecastData,
        startDate,
        endDate,
        birthData: natalData.birthData,
      });
      if (!resp.ok) throw new Error("PDF export failed");
      const blob = await resp.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `prognoza-${startDate}-${endDate}.pdf`;
      a.click();
      URL.revokeObjectURL(url);
      toast({ title: "Успех!", description: "PDF свален." });
    } catch (e: any) {
      toast({ title: "Грешка", description: e.message, variant: "destructive" });
    }
  };

  const renderTransit = (t: Transit) => {
    const planetName = t.transitPlanet || t.planet || "?";
    const planetSym = getPlanetSymbol(planetName) || planetName;
    const natalName = t.natalPoint || t.natal || "";
    const isHouse = /^\d+$/.test(natalName) || ["ASC","IC","DSC","MC"].includes(natalName);
    const aspectSym = getAspectSymbol(t.aspect) || t.aspect;

    return (
      <div className="mb-1 flex items-center gap-1">
        <span
          className="text-lg symbol-font"
          style={{ color: getPlanetColor(planetName) }}
          title={planetName}
        >
          {planetSym}
          {t.isRetrograde && (
            <span className="text-xs text-red-600 font-bold">R</span>
          )}
        </span>
        <span
          className="text-lg mx-1"
          style={{ color: getAspectColor(t.aspect) }}
          title={t.aspect}
        >
          {aspectSym}
        </span>
        {isHouse ? (
          <span className="text-sm text-purple-600">{natalName}</span>
        ) : (
          <span
            className="text-lg symbol-font"
            style={{ color: getPlanetColor(natalName) }}
            title={natalName}
          >
            {getPlanetSymbol(natalName) || natalName}
          </span>
        )}
        {t.orb && (
          <span className="text-xs text-gray-500">
            ({parseFloat(t.orb).toFixed(1)}°)
          </span>
        )}
      </div>
    );
  };

  const renderIngress = (ing: Ingress) => (
    <div className="mb-1 flex items-center gap-1">
      <span
        className="text-lg symbol-font"
        style={{ color: getPlanetColor(ing.planet) }}
        title={ing.planet}
      >
        {ing.planetSymbol}
        {ing.isRetrograde && (
          <span className="text-xs text-red-600 font-bold ml-1">R</span>
        )}
      </span>
      <span className="text-lg mx-1">→</span>
      <span
        className="text-lg symbol-font"
        style={{ color: getZodiacColor(ing.sign) }}
        title={ing.sign}
      >
        {ing.signSymbol}
      </span>
      {ing.time && <span className="text-xs text-gray-500 ml-1">({ing.time})</span>}
    </div>
  );

  // clean up SSE on unmount
  useEffect(() => {
    return () => {
      esRef.current?.close();
    };
  }, []);

  return (
    <div className="border-t-2 border-gray-200 pt-8 w-full">
      {/* 1 & 2) Заглавия */}
      <h3 className="text-2xl font-semibold mb-2 flex items-center gap-2">
        <TrendingUp /> Модул Прогнози
      </h3>
      <p className="text-lg text-gray-700 mb-6">Прогресии, Транзити, Ингресии</p>

      {/* форма */}
      <div className="grid md:grid-cols-2 gap-4 mb-6">
        <div>
          <Label htmlFor="start">От</Label>
          <Input
            id="start"
            type="date"
            value={startDate}
            onChange={(e) => onStartDateChange(e.target.value)}
          />
        </div>
        <div>
          <Label htmlFor="end">До</Label>
          <Input
            id="end"
            type="date"
            value={endDate}
            onChange={(e) => onEndDateChange(e.target.value)}
          />
        </div>
      </div>

      {/* бутони */}
      <div className="flex gap-4 mb-4">
        <Button onClick={handleCalculate} disabled={progress > 0 && progress < 100}>
          Изчисли Прогноза
        </Button>
        {forecastData.length > 0 && (
          <Button variant="outline" onClick={handleExportPDF}>
            <Download className="mr-2" /> Експорт PDF
          </Button>
        )}
      </div>

      {/* 4) анимиран, determinate прогрес бар */}
      {progress > 0 && progress < 100 && (
        <div className="w-full bg-gray-200 rounded overflow-hidden mb-6 h-2">
          <div
            className="h-full bg-blue-600 transition-all duration-200"
            style={{ width: `${progress}%` }}
          />
        </div>
      )}

      {/* таблица */}
      {forecastData.length > 0 ? (
        <div className="bg-white rounded-2xl shadow overflow-x-auto">
          <Table>
            <TableHeader className="astro-gradient-reverse text-white sticky top-0 z-10">
              <TableRow>
                <TableHead>Дата</TableHead>
                <TableHead>Прогресии</TableHead>
                <TableHead>Външни планети</TableHead>
                <TableHead>Венера</TableHead>
                <TableHead>Марс</TableHead>
                <TableHead>Меркурий R</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody className="divide-y divide-gray-200">
              {forecastData.map((day, idx) => {
                const progs = day.progressions || [];
                const progIngr = day.progressionIngressions || [];
                const outers = day.outerPlanets || [];
                const transIngr = day.transitIngresses || [];
                const venus = day.venus || [];
                const mars = day.mars || [];
                const mercR = day.mercuryRetro || [];

                const outerIngresses = [...progIngr, ...transIngr].filter((ing) =>
                  ["Юпитер", "Сатурн", "Уран", "Нептун", "Плутон"].includes(ing.planet)
                );
                const venusIngr = [...progIngr, ...transIngr].filter((ing) => ing.planet === "Венера");
                const marsIngr = [...progIngr, ...transIngr].filter((ing) => ing.planet === "Марс");
                const mercIngr = [...progIngr, ...transIngr].filter((ing) => ing.planet === "Меркурий");

                return (
                  <TableRow key={idx} className="hover:bg-gray-50">
                    <TableCell className="px-4 py-4 whitespace-nowrap">
                      {new Date(day.date).toLocaleDateString("bg-BG")}
                    </TableCell>

                    <TableCell className="px-4 py-4 align-top">
                      {(progs.length + progIngr.length) > 0 ? (
                        <div className="space-y-1">
                          {progs.map((t, j) => (
                            <div key={`p-${j}`}>{renderTransit(t)}</div>
                          ))}
                          {progIngr.map((ing, j) => (
                            <div key={`ip-${j}`}>{renderIngress(ing)}</div>
                          ))}
                        </div>
                      ) : (
                        <span className="text-gray-400">—</span>
                      )}
                    </TableCell>

                    <TableCell className="px-4 py-4 align-top">
                      {(outers.length + outerIngresses.length) > 0 ? (
                        <div className="space-y-1">
                          {outers.map((t, j) => (
                            <div key={`o-${j}`}>{renderTransit(t)}</div>
                          ))}
                          {outerIngresses.map((ing, j) => (
                            <div key={`oi-${j}`}>{renderIngress(ing)}</div>
                          ))}
                        </div>
                      ) : (
                        <span className="text-gray-400">—</span>
                      )}
                    </TableCell>

                    <TableCell className="px-4 py-4 align-top">
                      {(venus.length + venusIngr.length) > 0 ? (
                        <div className="space-y-1">
                          {venus.map((t, j) => (
                            <div key={`v-${j}`}>{renderTransit(t)}</div>
                          ))}
                          {venusIngr.map((ing, j) => (
                            <div key={`vlg-${j}`}>{renderIngress(ing)}</div>
                          ))}
                        </div>
                      ) : (
                        <span className="text-gray-400">—</span>
                      )}
                    </TableCell>

                    <TableCell className="px-4 py-4 align-top">
                      {(mars.length + marsIngr.length) > 0 ? (
                        <div className="space-y-1">
                          {mars.map((t, j) => (
                            <div key={`m-${j}`}>{renderTransit(t)}</div>
                          ))}
                          {marsIngr.map((ing, j) => (
                            <div key={`mlg-${j}`}>{renderIngress(ing)}</div>
                          ))}
                        </div>
                      ) : (
                        <span className="text-gray-400">—</span>
                      )}
                    </TableCell>

                    <TableCell className="px-4 py-4 align-top">
                      {(mercR.length + mercIngr.length) > 0 ? (
                        <div className="space-y-1">
                          {mercR.map((t, j) => (
                            <div key={`mr-${j}`}>{renderTransit(t)}</div>
                          ))}
                          {mercIngr.map((ing, j) => (
                            <div key={`mlrg-${j}`}>{renderIngress(ing)}</div>
                          ))}
                        </div>
                      ) : (
                        <span className="text-gray-400">—</span>
                      )}
                    </TableCell>
                  </TableRow>
                );
              })}
            </TableBody>
          </Table>
        </div>
      ) : (
        <div className="p-8 text-center text-gray-500">
          Натиснете „Изчисли Прогноза“, за да видите резултатите.
        </div>
      )}
    </div>
  );
}
