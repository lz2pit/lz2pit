// src/components/forecast-section.tsx
import React, { useState, useRef, useEffect } from "react";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import { TrendingUp, Download } from "lucide-react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { useToast } from "@/hooks/use-toast";
import { apiRequest } from "@/lib/queryClient";
import {
  getPlanetColor,
  getPlanetSymbol,
  getZodiacColor,
  getAspectSymbol,
  getAspectColor,
} from "@/lib/astrology-utils";
import type { NatalChartData, Coordinates } from "@shared/schema";

interface Transit {
  transitPlanet?: string;
  planet?: string;
  aspect: string;
  natalPoint?: string;
  natal?: string;
  orb: string;
  isRetrograde?: boolean;
}

interface Ingress {
  planet: string;
  planetSymbol: string;
  sign: string;
  signSymbol: string;
  isRetrograde?: boolean;
  time?: string;
}

interface DayForecast {
  date: string;
  progressions?: Transit[];
  outerPlanets?: Transit[];
  venus?: Transit[];
  mars?: Transit[];
  mercuryRetro?: Transit[];
  progressionIngressions?: Ingress[];
  transitIngresses?: Ingress[];
}

interface ForecastSectionProps {
  natalData: NatalChartData;
  coordinates: Coordinates | null;
  startDate: string;
  endDate: string;
  onStartDateChange: (d: string) => void;
  onEndDateChange: (d: string) => void;
}

export default function ForecastSection({
  natalData,
  coordinates,
  startDate,
  endDate,
  onStartDateChange,
  onEndDateChange,
}: ForecastSectionProps) {
  const { toast } = useToast();
  const [forecastData, setForecastData] = useState<DayForecast[]>([]);
  const [progress, setProgress] = useState(0);
  const esRef = useRef<EventSource | null>(null);

  const handleCalculate = async () => {
    if (!coordinates) {
      toast({ title: "Грешка", description: "Няма координати!", variant: "destructive" });
      return;
    }
    if (!startDate || !endDate) {
      toast({ title: "Грешка", description: "Моля въведете дата!", variant: "destructive" });
      return;
    }

    setProgress(0);
    esRef.current?.close();
    const es = new EventSource(
      `/api/forecast-progress?start=${startDate}&end=${endDate}`
    );
    es.onmessage = (e) => {
      try {
        const { percent } = JSON.parse(e.data);
        setProgress(percent);
      } catch {}
    };
    es.onerror = () => {
      es.close();
    };
    esRef.current = es;

    try {
      const result = await apiRequest("POST", "/api/calculate-forecast", {
        birthData: natalData.birthData,
        coordinates,
        startDate,
        endDate,
      }).then((r) => r.json());

      es.close();
      setProgress(100);

      if (result.success && Array.isArray(result.data)) {
        // DEBUG: Логваме получените данни
        console.log("Forecast data received:", result.data);
        
        // Проверяваме за прогресивни ингресии
        const daysWithProgIngresses = result.data.filter(day => 
          day.progressionIngresses && day.progressionIngresses.length > 0
        );
        console.log(`Found ${daysWithProgIngresses.length} days with progression ingresses`);
        
        if (daysWithProgIngresses.length > 0) {
          console.log("First day with progression ingresses:", daysWithProgIngresses[0]);
          console.log("Progression ingresses details:", daysWithProgIngresses[0].progressionIngresses);
        }
        
        // Проверяваме специално за 22.10.2025
        const oct22 = result.data.find(day => day.date === '2025-10-22');
        if (oct22) {
          console.log("Data for 2025-10-22:", oct22);
          console.log("progressionIngresses:", oct22.progressionIngresses);
        }
        
        setForecastData(result.data);
        toast({
          title: "Успех!",
          description: `Изчислени ${result.data.length} дни.`,
        });
      } else {
        toast({
          title: "Грешка",
          description: result.error || "Грешка при изчисляване",
          variant: "destructive",
        });
      }
    } catch (error: any) {
      es.close();
      setProgress(0);
      toast({
        title: "Грешка",
        description: error.message || "Грешка при изчисляване",
        variant: "destructive",
      });
    }
  };

  const handleExportPDF = async () => {
    if (!forecastData.length) return;
    
    try {
      const response = await apiRequest("POST", "/api/export-forecast-pdf", {
        forecastData,
        startDate,
        endDate,
        birthData: natalData.birthData
      });
      
      if (!response.ok) {
        throw new Error('Грешка при генериране на PDF');
      }
      
      const blob = await response.blob();
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.style.display = 'none';
      a.href = url;
      a.download = `forecast_${startDate}_${endDate}.pdf`;
      document.body.appendChild(a);
      a.click();
      window.URL.revokeObjectURL(url);
      
      toast({
        title: "Успех!",
        description: "PDF файлът е изтеглен успешно.",
      });
    } catch (error) {
      toast({
        title: "Грешка",
        description: "Грешка при експорт на PDF",
        variant: "destructive",
      });
    }
  };

  const renderTransit = (t: Transit) => {
    const planetName = t.transitPlanet || t.planet || "";
    const natalName = t.natalPoint || t.natal || "";
    const isAspectToHouse = /^[\d]+$|^(ASC|DSC|MC|IC)$/.test(natalName);

    return (
      <div className="mb-1 flex items-center gap-1">
        <span
          className="text-lg symbol-font"
          style={{ color: getPlanetColor(planetName) }}
          title={planetName}
        >
          {getPlanetSymbol(planetName) || planetName}
          {t.isRetrograde && <span className="text-xs text-red-600 font-bold ml-1">R</span>}
        </span>
        <span
          className="text-lg mx-1"
          style={{ color: getAspectColor(t.aspect) }}
          title={t.aspect}
        >
          {getAspectSymbol(t.aspect)}
        </span>
        {isAspectToHouse ? (
          <span className="text-sm text-purple-600">{natalName}</span>
        ) : (
          <span
            className="text-lg symbol-font"
            style={{ color: getPlanetColor(natalName) }}
            title={natalName}
          >
            {getPlanetSymbol(natalName) || natalName}
          </span>
        )}
        {t.orb && (
          <span className="text-xs text-gray-500">({parseFloat(t.orb).toFixed(1)}°)</span>
        )}
      </div>
    );
  };

  const renderIngress = (ing: Ingress) => (
    <div className="mb-1 flex items-center gap-1">
      <span
        className="text-lg symbol-font"
        style={{ color: getPlanetColor(ing.planet) }}
        title={ing.planet}
      >
        {ing.planetSymbol}
        {ing.isRetrograde && <span className="text-xs text-red-600 font-bold ml-1">R</span>}
      </span>
      <span className="text-lg mx-1">→</span>
      <span
        className="text-lg symbol-font"
        style={{ color: getZodiacColor(ing.sign) }}
        title={ing.sign}
      >
        {ing.signSymbol}
      </span>
      {ing.time && <span className="text-xs text-gray-500 ml-1">({ing.time})</span>}
    </div>
  );

  useEffect(() => () => { esRef.current?.close() }, []);

  // Помощна функция за извличане на базовото име на планета
  const getBasePlanetName = (planetName: string): string => {
    if (planetName.startsWith("Прог. ")) {
      return planetName.replace("Прог. ", "");
    }
    return planetName;
  };

  return (
    <div className="border-t-2 border-gray-200 pt-8 w-full">
      <h3 className="text-2xl font-semibold mb-2 flex items-center gap-2">
        <TrendingUp /> Прогресии, Транзити, Ингресии
      </h3>
      <p className="text-lg text-gray-700 mb-6">Прогноза</p>

      <div className="grid md:grid-cols-2 gap-4 mb-6">
        <div>
          <Label htmlFor="start">От</Label>
          <Input
            id="start"
            type="date"
            value={startDate}
            onChange={(e) => onStartDateChange(e.target.value)}
          />
        </div>
        <div>
          <Label htmlFor="end">До</Label>
          <Input
            id="end"
            type="date"
            value={endDate}
            onChange={(e) => onEndDateChange(e.target.value)}
          />
        </div>
      </div>

      <div className="flex gap-4 mb-4">
        <Button onClick={handleCalculate} disabled={progress > 0 && progress < 100}>
          {progress > 0 && progress < 100 ? "Изчислява..." : "Изчисли Прогноза"}
        </Button>
        {forecastData.length > 0 && (
          <Button variant="outline" onClick={handleExportPDF}>
            <Download className="mr-2" /> Експорт PDF
          </Button>
        )}
      </div>

      {/* детерминиран прогрес бар + % */}
      {progress > 0 && (
        <div className="mb-6">
          <div className="w-full bg-gray-200 rounded overflow-hidden h-2">
            <div
              className="h-full bg-blue-600 transition-all duration-200"
              style={{ width: `${progress}%` }}
            />
          </div>
          <div className="text-right text-sm text-gray-600 mt-1">
            {progress}% изчислено
          </div>
        </div>
      )}

      {forecastData.length > 0 ? (
        <div className="bg-white rounded-2xl shadow overflow-x-auto">
          <Table>
            <TableHeader className="astro-gradient-reverse text-white sticky top-0 z-10">
              <TableRow>
                <TableHead>Дата</TableHead>
                <TableHead>Прогресии</TableHead>
                <TableHead>Външни планети</TableHead>
                <TableHead>Венера</TableHead>
                <TableHead>Марс</TableHead>
                <TableHead>Меркурий R</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody className="divide-y divide-gray-200">
              {forecastData.map((day, idx) => {
                const progs = day.progressions || [];
                const progIngr = day.progressionIngressions || [];
                const outers = day.outerPlanets || [];
                const transIngr = day.transitIngresses || [];
                const venus = day.venus || [];
                const mars = day.mars || [];
                const mercR = day.mercuryRetro || [];

                // ПРОГРЕСИВНИ ИНГРЕСИИ - показваме в колоната "Прогресии"
                const progressionColumnIngresses = progIngr;
                
                // ТРАНЗИТНИ ИНГРЕСИИ - филтрираме по планети за съответните колони
                const outerIngresses = transIngr.filter((ing) => {
                  const baseName = getBasePlanetName(ing.planet);
                  return ["Юпитер", "Сатурн", "Уран", "Нептун", "Плутон"].includes(baseName);
                });
                
                const venusIngr = transIngr.filter((ing) => {
                  const baseName = getBasePlanetName(ing.planet);
                  return baseName === "Венера";
                });
                
                const marsIngr = transIngr.filter((ing) => {
                  const baseName = getBasePlanetName(ing.planet);
                  return baseName === "Марс";
                });
                
                const mercIngr = transIngr.filter((ing) => {
                  const baseName = getBasePlanetName(ing.planet);
                  return baseName === "Меркурий";
                });
                
                return (
                  <TableRow key={idx} className="hover:bg-gray-50">
                    <TableCell className="px-4 py-4 whitespace-nowrap">
                      {new Date(day.date).toLocaleDateString("bg-BG")}
                    </TableCell>
                    
                    {/* Колона ПРОГРЕСИИ - включва прогресивни аспекти И прогресивни ингресии */}
                    <TableCell className="px-4 py-4 align-top">
                      {(progs.length + progressionColumnIngresses.length) > 0 ? (
                        <div className="space-y-1">
                          {progs.map((t, j) => <div key={`p-${j}`}>{renderTransit(t)}</div>)}
                          {progressionColumnIngresses.length > 0 && (
                            <>
                              {console.log(`Rendering ${progressionColumnIngresses.length} progression ingresses for ${day.date}`)}
                              {progressionColumnIngresses.map((ing, j) => (
                                <div key={`pi-${j}`} className="border-t border-gray-200 pt-1 mt-1">
                                  {renderIngress(ing)}
                                </div>
                              ))}
                            </>
                          )}
                        </div>
                      ) : <span className="text-gray-400">—</span>}
                    </TableCell>
                    
                    {/* Колона ВЪНШНИ ПЛАНЕТИ */}
                    <TableCell className="px-4 py-4 align-top">
                      {(outers.length + outerIngresses.length) > 0 ? (
                        <div className="space-y-1">
                          {outers.map((t, j) => <div key={`o-${j}`}>{renderTransit(t)}</div>)}
                          {outerIngresses.map((ing, j) => (
                            <div key={`oi-${j}`} className="border-t border-gray-200 pt-1 mt-1">
                              {renderIngress(ing)}
                            </div>
                          ))}
                        </div>
                      ) : <span className="text-gray-400">—</span>}
                    </TableCell>
                    
                    {/* Колона ВЕНЕРА */}
                    <TableCell className="px-4 py-4 align-top">
                      {(venus.length + venusIngr.length) > 0 ? (
                        <div className="space-y-1">
                          {venus.map((t, j) => <div key={`v-${j}`}>{renderTransit(t)}</div>)}
                          {venusIngr.map((ing, j) => (
                            <div key={`vi-${j}`} className="border-t border-gray-200 pt-1 mt-1">
                              {renderIngress(ing)}
                            </div>
                          ))}
                        </div>
                      ) : <span className="text-gray-400">—</span>}
                    </TableCell>
                    
                    {/* Колона МАРС */}
                    <TableCell className="px-4 py-4 align-top">
                      {(mars.length + marsIngr.length) > 0 ? (
                        <div className="space-y-1">
                          {mars.map((t, j) => <div key={`m-${j}`}>{renderTransit(t)}</div>)}
                          {marsIngr.map((ing, j) => (
                            <div key={`mi-${j}`} className="border-t border-gray-200 pt-1 mt-1">
                              {renderIngress(ing)}
                            </div>
                          ))}
                        </div>
                      ) : <span className="text-gray-400">—</span>}
                    </TableCell>
                    
                    {/* Колона МЕРКУРИЙ R */}
                    <TableCell className="px-4 py-4 align-top">
                      {(mercR.length + mercIngr.length) > 0 ? (
                        <div className="space-y-1">
                          {mercR.map((t, j) => <div key={`mr-${j}`}>{renderTransit(t)}</div>)}
                          {mercIngr.map((ing, j) => (
                            <div key={`mri-${j}`} className="border-t border-gray-200 pt-1 mt-1">
                              {renderIngress(ing)}
                            </div>
                          ))}
                        </div>
                      ) : <span className="text-gray-400">—</span>}
                    </TableCell>
                  </TableRow>
                );
              })}
            </TableBody>
          </Table>
        </div>
      ) : (
        <div className="p-8 text-center text-gray-500">
          Натиснете „Изчисли Прогноза", за да видите резултатите.
        </div>
      )}
    </div>
  );
}